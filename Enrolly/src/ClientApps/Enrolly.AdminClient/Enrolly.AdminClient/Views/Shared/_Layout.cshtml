<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Enrolly Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<body>
<nav class="sidebar">
    <div class="sidebar-logo">
        <div class="wordmark">Enrolly</div>
        <div class="sub">Admin Panel</div>
    </div>
    <div class="sidebar-nav">
        <div class="nav-section">Общее</div>
        
        <div class="nav-section" style="margin-top:10px">Справочники</div>
        <a href="/Dictionary/Programs" class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Programs" ? "active" : "")">
            Программы
        </a>
    </div>
    <div class="sidebar-footer">
        <form action="/Account/Logout" method="post">
            <button type="submit" class="logout-btn">→ Выйти</button>
        </form>
    </div>
</nav>

<div class="main">
    <div class="topbar">
        <span class="topbar-title">
            enrolly<span class="sep">/</span><span class="current">@ViewData["Title"]</span>
        </span>
    </div>
    <div class="content">
        @RenderBody()
    </div>
</div>
</body>
</html>
