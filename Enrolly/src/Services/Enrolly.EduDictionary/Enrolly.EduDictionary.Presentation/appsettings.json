{
  "ServiceName": "Enrolly.EduDictionary",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kreosoft": {
    "defaultUrl" : "https://1c-mockup.kreosoft.space",
    "eduLevels" : "api/dictionary/education_levels",
    "docTypes"  : "api/dictionary/document_types",
    "faculties" : "api/dictionary/faculties",
    "programs" : "/api/dictionary/programs"
  },
  "ConnectionStrings" : {
    "DbConnection": "Host=localhost;Port=5432;Database=enrolly_documents_db;Username=postgres;Password=password",
    "KreosoftConnection" : "student:ny6gQnyn4ecbBrP9l1Fz"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
