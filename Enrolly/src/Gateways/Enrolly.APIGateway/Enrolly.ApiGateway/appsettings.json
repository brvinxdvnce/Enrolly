{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "admissions-route" : {
        "ClusterId": "admissions-cluster",
        "AuthorizationPolicy": "AuthPolicy",
        "Match": { "Path": "/api/v1/admissions/{**catch-all}" }
      },
      "accounts-route" : {
        "ClusterId": "accounts-cluster",
        "AuthorizationPolicy": "AuthPolicy",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "auth-route" : {
        "ClusterId": "accounts-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "documents-route" : {
        "ClusterId": "documents-cluster",
        "AuthorizationPolicy": "AuthPolicy",
        "Match": { "Path": "/api/v1/documents/{**catch-all}" }
      },
      "edu-dictionary-route" : {
        "ClusterId": "edu-dictionary-cluster",
        "AuthorizationPolicy": "AuthPolicy",
        "Match": { "Path": "/api/v1/admin/references/{**catch-all}" }
      }
    },
    "Clusters": {
      "admissions-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5091" }
        }
      },
      "accounts-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5092" }
        }
      },
      "documents-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5093" }
        }
      },
      "edu-dictionary-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5094" }
        }
      }
    }
  }
}